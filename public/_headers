# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QJyf8eMpbV08kWdN687YNZ0BejV7M6/GXr104eSGO6c=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# The extension's side panel (F53, D110) frames these pages, and only these: the same policy, with framing allowed
# for our own extension ids alone: the Chrome Web Store's and the development build's (also in src/lib/panel.ts). The "!" line drops the policy from /* first, so the two are not both enforced.
/panel/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QJyf8eMpbV08kWdN687YNZ0BejV7M6/GXr104eSGO6c=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors chrome-extension://mjgmdkefkachokakimleommdodchkgfo chrome-extension://jdbigbpnbadjaphglkhomapjbhajbphe; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Robots-Tag: noindex
/panel
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QJyf8eMpbV08kWdN687YNZ0BejV7M6/GXr104eSGO6c=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors chrome-extension://mjgmdkefkachokakimleommdodchkgfo chrome-extension://jdbigbpnbadjaphglkhomapjbhajbphe; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Robots-Tag: noindex

# Built files have a hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font files keep their name; a changed font gets a new name, so they can be cached for a year too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pages already revalidates HTML on every visit. The service worker must be too,
# or a new version never reaches students who installed the app.
/sw.js
  Cache-Control: no-cache
