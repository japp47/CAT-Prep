  {
    "id": "mcc-five-friends", "set": "bin-five-friends", "drop": [1],
    "statements": [
      {"text": "A and B are of different types.", "expr": {"xor": [{"is": ["A", "T"]}, {"is": ["B", "T"]}]}},
      {"text": "C is a truth-teller.", "expr": {"is": ["C", "T"]}},
      {"text": "Exactly three of the five are truth-tellers.", "expr": {"eq": [{"count": [{"is": ["A", "T"]}, {"is": ["B", "T"]}, {"is": ["C", "T"]}, {"is": ["D", "T"]}, {"is": ["E", "T"]}]}, 3]}},
      {"text": "D and E are of the same type.", "expr": {"iff": [{"is": ["D", "T"]}, {"is": ["E", "T"]}]}},
      {"text": "All five are truth-tellers.", "expr": {"and": [{"is": ["A", "T"]}, {"is": ["B", "T"]}, {"is": ["C", "T"]}, {"is": ["D", "T"]}, {"is": ["E", "T"]}]}},
      {"text": "A and C are both liars.", "expr": {"and": [{"is": ["A", "L"]}, {"is": ["C", "L"]}]}}
    ]
  },
  {
