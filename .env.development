# npm run dev only: shows Sync in Settings and talks to the Go server through /api (server/README.md).
VITE_API_ENABLED=1
# Shows "Sign in with Google" (B7). Without GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in server/.env the button
# comes back with "not available yet"; with them, the real Google sign-in runs on localhost.
VITE_GOOGLE_SIGNIN=1
