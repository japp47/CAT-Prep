# Copy to .env for local development: cp .env.example .env
# Never commit .env. Live values are secrets in the deploy, never in a file.
ENV=dev
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Live only (Render): /v1 stays off in prod until all three are set. Make the first two with: openssl rand -hex 32
# PROXY_SECRET=
# IP_HASH_KEY=
# GOOGLE_CLIENT_ID=      (Google Cloud → APIs and services → Credentials → OAuth client, Web application)
# GOOGLE_CLIENT_SECRET=  (redirect URI for local runs: http://localhost:5173/api/v1/auth/google/callback; the site needs VITE_GOOGLE_SIGNIN=1)
# TURNSTILE_SECRET=      (Cloudflare dashboard, Turnstile widget's secret key; in dev, unset = no bot check)

# The API connects as cat_app: it can read and write data but never change the schema.
DATABASE_URL=postgres://cat_app:cat_app@localhost:5433/cat?sslmode=disable

# Migrations connect as the owner, as a separate step (make migrate). The API never uses this.
MIGRATE_DATABASE_URL=postgres://cat:cat@localhost:5433/cat?sslmode=disable

# Only for `make test-int`, as the owner. It is emptied by the tests: never point it at real data.
TEST_DATABASE_URL=postgres://cat:cat@localhost:5433/cat_test?sslmode=disable
