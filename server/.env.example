# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production values live in Cloud Run secrets.
ENV=dev
PORT=8080
DATABASE_URL=postgres://cat:cat@localhost:5433/cat?sslmode=disable
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Only for `make test-int`. It is emptied by the tests: never point it at real data.
TEST_DATABASE_URL=postgres://cat:cat@localhost:5433/cat_test?sslmode=disable
`