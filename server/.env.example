# Copy to .env for local development: cp .env.example .env
# Never commit .env. Live values are secrets in the deploy, never in a file.
ENV=dev
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Live only (Render): /v1 stays off in prod until all three are set. Make the first two with: openssl rand -hex 32
# PROXY_SECRET=
# IP_HASH_KEY=
# GOOGLE_CLIENT_ID=      (Google Cloud → APIs and services → Credentials → OAuth client, Web application)
# GOOGLE_CLIENT_SECRET=  (redirect URI for local runs: http://localhost:5173/api/v1/auth/google/callback; the site needs VITE_GOOGLE_SIGNIN=1)
# TURNSTILE_SECRET=      (Cloudflare dashboard, Turnstile widget's secret key; in dev, unset = no bot check)

# Postgres connections the API may hold (default 5, the free plan). 10 to 15 through Supabase's pooler on a bigger plan.
# DB_MAX_CONNS=5

# The API connects as cat_app: it can read and write data but never change the schema.
DATABASE_URL=postgres://cat_app:cat_app@localhost:5433/cat?sslmode=disable

# Migrations connect as the owner, as a separate step (make migrate). The API never uses this.
MIGRATE_DATABASE_URL=postgres://cat:cat@localhost:5433/cat?sslmode=disable

# Only for `make test-int`, as the owner. It is emptied by the tests: never point it at real data.
TEST_DATABASE_URL=postgres://cat:cat@localhost:5433/cat_test?sslmode=disable

# AI summary feedback (F36, docs/design/explain-mistake.md). Off unless AI_ENABLED=1.
# A new generation needs a student signed in with Google.
# Models and their order live in server/internal/ai/models.json (no secrets there). Keys come from the variable a
# provider names: GROQ_API_KEYS, comma separated (a second key is a spare for when one is revoked; Groq's limits are
# per account and per model, so it adds no quota).
# Change the order without a deploy: AI_SUMMARY = catalog names, comma separated. Another file: AI_CATALOG.
# Laptop with Ollama (`ollama pull gpt-oss:20b`), no key: AI_SUMMARY=ollama-gpt-oss-20b,
# and AI_CONTENT_URL=http://localhost:4173/ai/rc.json from `npm run build && npx vite preview`.
# AI_ENABLED=
# GROQ_API_KEYS=
# AI_SUMMARY=
# AI_CATALOG=
# AI_CONTENT_URL=
# AI_DAILY_TOKENS=
# AI_PER_STUDENT=
# New generations per network address an hour (30).
# AI_PER_ADDRESS=
